# ---- Next.js ----
.next/
out/
build/

# ---- Dependencies ----
node_modules/

# ---- Environment / secrets ----
.env*.local
# Keep .env.example (no real values, safe to commit)
!.env.example

# ---- TypeScript ----
tsconfig.tsbuildinfo
*.tsbuildinfo

# ---- Vendored type overrides (pinned via package.json instead) ----
# types/* (not types/) so the negation below can re-include tracked files
types/*
!types/gaussian-splats-3d.d.ts

# ---- Claude Code ----
.claude/settings.local.json
# LOCK.tmp is the multi-agent file lock convention (see .claude/AGENTS.md)
LOCK.tmp

# ---- Tool artifacts ----
.aionrs/
.playwright-mcp/
.memsearch/

# ---- Licensed reference imagery -- keep out of a public repo ----
# Files stay on disk for reference; they are just never committed.
reference-photos/tournament/
reference-photos/sawgrass-17-*

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- Vercel (if deployed later) ----
.vercel/

# ---- Windows download markers (alternate data streams) ----
*:Zone.Identifier
