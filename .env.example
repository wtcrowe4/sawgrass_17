# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and never committed.

# Google Maps Static API -- used by /api/satellite to pull aerial imagery of TPC Sawgrass hole 17
# Enable "Maps Static API" at https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Server-side Maps key used in the /api/satellite proxy route (same value as above)
GOOGLE_MAPS_KEY=

# Cesium Ion token -- for Photorealistic 3D Tiles / terrain streaming (optional in v1)
# Get a token at https://ion.cesium.com/tokens
NEXT_PUBLIC_CESIUM_TOKEN=
